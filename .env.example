APP_NAME="Laya Playground"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# Lets `php artisan serve` answer the status poll while a prediction runs.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# The playground has no database: sessions and cache live on disk.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# laya-serve. Under Docker Compose this is http://laya:8000; run outside Docker, point it at your own laya-serve.
LAYA_URL=http://localhost:8000
LAYA_API_KEY=
